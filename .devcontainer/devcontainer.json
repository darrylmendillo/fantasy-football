{
  "name": "fantasy-football",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },
  "postCreateCommand": "pip install --user uv && ~/.local/bin/uv sync",
  "postAttachCommand": "echo 'Codespace ready. Run: uv run python -m yahoo_fantasy_mcp'",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:${containerWorkspaceFolder}/.venv/bin:/root/.local/bin"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
