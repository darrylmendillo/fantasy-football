# ---------------------------------------------------------------------------
# Server-level configuration ONLY.
#
# There is deliberately no league key and no token path here. Each user's
# Yahoo tokens are obtained through the OAuth flow at runtime and stored
# encrypted by FastMCP; the league is chosen per request. Anything
# user-specific in this file would be a multi-tenancy bug.
# ---------------------------------------------------------------------------

# Yahoo Developer app credentials — https://developer.yahoo.com/apps/
# You ALSO need an approved Fantasy Sports API Access Application for this
# Client ID at https://sports.yahoo.com/developer/access/ (a separate review
# step). Without it, calls fail with additional_authorization_required.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Public HTTPS base URL this server is reachable at. MCP clients require TLS;
# plain HTTP will not be accepted by Claude or ChatGPT.
PUBLIC_BASE_URL=https://your-host.example.com

# Yahoo OAuth scope. "fspt-w" = Fantasy Sports read/write (required for
# lineup/add-drop/trade actions). Use "fspt-r" if Yahoo has only approved
# read access — write tools then fail cleanly with WRITE_NOT_APPROVED
# instead of failing obscurely at call time.
YAHOO_SCOPE=fspt-w

# Optional. Port to listen on. Default: 8000
# PORT=8000

# Optional. SQLite file for users, usage history, and pending proposals.
# Default: ./yahoo_fantasy_mcp.db  (gitignored — see .gitignore)
# DB_PATH=./yahoo_fantasy_mcp.db

# Optional. How long a confirmation token stays valid, in seconds.
# Long enough for a natural back-and-forth, short enough that proposals do
# not linger. Default: 300
# PROPOSAL_TTL_SECONDS=300

# Optional. Poll interval during a live draft, in seconds. Default: 5
# YAHOO_POLL_INTERVAL_SECONDS=5
