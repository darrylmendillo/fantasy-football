# Yahoo Developer app credentials with Fantasy Sports read permission.
# Create/manage the app at https://developer.yahoo.com/apps/, and request
# Fantasy Sports API access at https://sports.yahoo.com/developer/access/
# (a separate approval step from app creation). Do not grant write scope.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# The single league this server serves, e.g. 449.l.99001
YAHOO_LEAGUE_KEY=

# Optional. How often to poll during a live draft. Default: 5
# YAHOO_POLL_INTERVAL_SECONDS=5

# Optional. Roster spots per team in your league. Only affects the
# is_complete flag on draft results. Default: 16
# YAHOO_ROSTER_SIZE=16
